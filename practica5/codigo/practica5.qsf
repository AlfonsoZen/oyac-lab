set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY practica5
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "13:27:28  OCTOBER 29, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# ---- Archivos de diseno ----
set_global_assignment -name VHDL_FILE practica5.vhd
set_global_assignment -name VHDL_FILE contador.vhd
set_global_assignment -name VHDL_FILE memory.vhd
set_global_assignment -name VHDL_FILE divisor_datos.vhd
set_global_assignment -name VHDL_FILE mux5.vhd
set_global_assignment -name VHDL_FILE mux1X2X1.vhd
set_global_assignment -name VHDL_FILE mux1X2X1_3.vhd
set_global_assignment -name VHDL_FILE incrementador.vhd
set_global_assignment -name VHDL_FILE register3.vhd
set_global_assignment -name VHDL_FILE div_frec.vhd

# ---- Asignacion de pines - Terasic DE10-Lite (MAX 10 10M50DAF484C7G) ----
set_location_assignment PIN_P11  -to CLK
set_location_assignment PIN_B8   -to RESET
set_location_assignment PIN_C10  -to X
set_location_assignment PIN_C11  -to Y
set_location_assignment PIN_D12  -to Z
set_location_assignment PIN_C12  -to W
set_location_assignment PIN_A8   -to S1
set_location_assignment PIN_A9   -to S2
set_location_assignment PIN_A10  -to U1
set_location_assignment PIN_B10  -to U2
set_location_assignment PIN_B11  -to EDO[2]
set_location_assignment PIN_A11  -to EDO[1]
set_location_assignment PIN_D14  -to EDO[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to RESET
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to X
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Y
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Z
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to W
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to U1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to U2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to EDO[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to EDO[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to EDO[0]
